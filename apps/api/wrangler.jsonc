{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dodo",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-11",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BETTER_AUTH_URL": "https://dodotasks.xyz",
		"BETTER_AUTH_ADDITIONAL_ORIGINS": "https://dodo.adbooth.workers.dev",
		"AUTH_EMAIL_FROM": "Dodo <login@dodotasks.xyz>",
		"AUTH_EMAIL_DEV_URL": ""
	},
	"workers_dev": true,
	"routes": [{ "pattern": "dodotasks.xyz", "custom_domain": true }],
	"secrets": { "required": ["BETTER_AUTH_SECRET", "RESEND_API_KEY"] },
	"assets": {
		"directory": "../app/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "dodo",
			"migrations_dir": "migrations",
			"database_id": "2c2d038d-db07-43cd-8c3b-8a81f38536de"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
